+          if (UNIX AND CMAKE_CUDA_COMPILER_VERSION VERSION_GREATER_EQUAL 13.2 AND CMAKE_CUDA_COMPILER_VERSION VERSION_LESS 13.4)
             # Generate cudafe++-parseable copies of the CCCL headers that contain global-qualified
@@ -606,2 +606,5 @@
             SOURCES ${onnxruntime_cuda_llm_srcs})
+          # The Reachy voice pipeline does not use ORT's LLM/MoE operators. Keep the
+          # link-compatible quick-build variants and avoid exhaustive CUTLASS instantiations.
+          target_compile_definitions(onnxruntime_providers_cuda_llm PRIVATE ORT_QUICK_BUILD=1)
         endif()
