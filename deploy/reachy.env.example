# Copy to ~/.config/reachy-assistant/env and chmod 600.
# The default Thor profile exposes the UI directly on the trusted LAN.
REACHY_PRODUCTION_MODE=false
REACHY_PLATFORM=thor

# Pinned-runtime defaults. Keep enough unified memory for STT, TTS, and the OS.
GPU_MEMORY_UTILIZATION=0.50
# MAX_MODEL_LEN=4096
# MAX_NUM_SEQS=2
# PULL_POLICY=missing
